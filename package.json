{
  "scripts": {
    "create-browser-action": "node ./scripts/create-browser-action.js",
    "watch-options-html": "npx -y chokidar-cli options.html -c \"npm run create-browser-action\" --initial",
    "release": "node ./scripts/release.js",
    "typecheck": "npx --yes -p typescript tsc -p jsconfig.json --noEmit && npx --yes -p typescript tsc -p scripts/jsconfig.json --noEmit",
    "prebuild": "npm run create-browser-action",
    "build": "node ./scripts/build.js",
    "build-mv2": "node ./scripts/build.js 2",
    "build-mv3": "node ./scripts/build.js 3",
    "lint-mv2": "npm run copy-mv2 && web-ext lint",
    "lint-mv3": "npm run copy-mv3 && web-ext lint",
    "copy-mv2": "node ./scripts/copy.js manifest.mv2.json manifest.json",
    "copy-mv3": "node ./scripts/copy.js manifest.mv3.json manifest.json"
  },
  "webExt": {
    "ignoreFiles": [
      "**/*",
      "!_locales",
      "!_locales/**",
      "!icons",
      "!icons/icon{16,32,48,64,96,128}.png",
      "!background.js",
      "!browser_action.html",
      "!content.js",
      "!LICENSE",
      "!manifest.json",
      "!NOTICE",
      "!options.css",
      "!options.html",
      "!options.js",
      "!routes.js",
      "!settings.js",
      "!storage.js",
      "!style.css"
    ]
  },
  "devDependencies": {
    "@types/chrome": "0.x",
    "@types/node": "25.x",
    "semver": "7.x",
    "web-ext": "7.x"
  }
}
